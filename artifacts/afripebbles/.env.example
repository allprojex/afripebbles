# Copy to .env and fill in for local dev.
PORT=5173
BASE_PATH=/
# Port the api-server dev process is listening on (see artifacts/api-server/.env)
API_PORT=5000

# Supabase Project Settings → API. The anon key is safe to expose to the
# browser (it has no privileges by itself — the API server independently
# verifies every admin request). Used by the /admin area for login only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
