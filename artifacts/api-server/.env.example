# Copy to .env and fill in for local dev.
PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Supabase Project Settings → API. SERVICE_ROLE_KEY is a server-only secret —
# never expose it to the browser or commit it. Used to verify admin sessions
# and to write to Storage buckets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
