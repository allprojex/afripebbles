# Copy to .env and fill in for local dev.
PORT=5000
# Interface to bind to. Defaults to 127.0.0.1 (loopback-only) when unset —
# safe for both local dev (reached via localhost) and production behind
# Nginx. Only set this to 0.0.0.0 (or another interface) if something needs
# to reach this process directly from outside the host.
# HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Supabase Project Settings → API. SERVICE_ROLE_KEY is a server-only secret —
# never expose it to the browser or commit it. Used to verify admin sessions
# and to write to Storage buckets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
